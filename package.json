{
  "name": "flux-cache",
  "version": "0.1.0",
  "description": "Predictable caching, request deduplication and invalidation for React data fetching.",
  "license": "MIT",
  "author": "FluxCache contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iambandirakesh/FluxCache.git"
  },
  "homepage": "https://github.com/iambandirakesh/FluxCache#readme",
  "bugs": {
    "url": "https://github.com/iambandirakesh/FluxCache/issues"
  },
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "docs",
    "bench/README.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ],
      "testing": [
        "./dist/testing/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "bench": "pnpm build && node bench/run.mjs",
    "bench:ci": "pnpm build && node bench/run.mjs --check --json --out bench/results/ci.json --iterations 500 --warmup 50 --samples 3",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "publint && attw --pack .",
    "example:dev": "pnpm --filter flux-cache-example dev",
    "verify:example": "pnpm --filter flux-cache-example typecheck && pnpm --filter flux-cache-example build",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm verify:example && pnpm check:package"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.13.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.0",
    "publint": "^0.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.0",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "keywords": [
    "react",
    "cache",
    "prefetch",
    "deduplication",
    "data-fetching",
    "typescript"
  ]
}
